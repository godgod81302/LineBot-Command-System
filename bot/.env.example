# LINE Messaging API（到 LINE Developers Console 建 Channel 取得）
LINE_CHANNEL_SECRET=填你的_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=填你的_channel_access_token

# chatgpt2api（本機 Docker 服務）
CHATGPT2API_BASE_URL=http://127.0.0.1:3000
CHATGPT2API_AUTH_KEY=填chatgpt2api的auth-key
CHATGPT2API_IMAGE_MODEL=gpt-image-2

# 對外 HTTPS 根網址（nginx 反代 /linebot/ 到本服務的網域）
LINEBOT_PUBLIC_BASE_URL=https://factory.estateagent-tw.com

# 可選
LINEBOT_IMAGE_TIMEOUT_SECS=300
LINEBOT_DAILY_PUSH_TIME=07:00
LINEBOT_ELDER_STYLE_DEDUP=12
LINEBOT_MAX_USER_PHOTOS=3
